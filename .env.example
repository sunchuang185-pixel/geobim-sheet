# Server bind settings
HOST=127.0.0.1
PORT=8765

# Persistent storage for task state, uploaded files, and generated PDF/CSV/DXF packages
GEOBIM_DATA_DIR=./data/geobim_review

# Public demo: set false to restrict to synthetic scenarios; Self-hosted: set true to allow uploads
GEOBIM_ALLOW_UPLOAD=true

# Tool-calling LLM backend (server-side only; keys are never exposed to browser clients)
# Options:
#   demo   -> Deterministic tool planner for key-free public demo (runs the same 6 Python tools)
#   ollama -> Local Ollama server (e.g. qwen2.5:7b, qwen3:8b, llama3.1:8b)
#   openai -> Any OpenAI-compatible Chat Completions API (OpenAI, Gemini OpenAI endpoint, DeepSeek, DashScope, vLLM)
LLM_PROVIDER=demo

# --- Example 1: Local Ollama ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:7b

# --- Example 2: OpenAI-compatible Cloud API (OpenAI / DeepSeek / Google Gemini) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-server-side-api-key

# --- Example 3: Google Gemini via OpenAI-compatible endpoint ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your-gemini-api-key

LLM_TIMEOUT_SECONDS=90
